DEBUG=True
SECRET_KEY=
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# Cuenta de Google fija de la agencia (Gmail + Calendar). Un admin la conecta una vez desde Configuración → Google
# y el servidor guarda el refresh token cifrado. En Google Cloud, la URI de redirección autorizada del cliente OAuth
# (tipo "Aplicación web") tiene que ser <backend>/api/auth/google/callback/.
AURA_GOOGLE_CLIENT_ID=
AURA_GOOGLE_CLIENT_SECRET=
# Opcionales: URI de callback explícita (si no, se arma con el host del request), email sugerido al elegir cuenta y
# clave Fernet propia para cifrar el token (si no, se deriva de SECRET_KEY: cambiar SECRET_KEY obliga a reconectar).
AURA_GOOGLE_REDIRECT_URI=
AURA_GOOGLE_LOGIN_HINT=
AURA_GOOGLE_TOKEN_KEY=
# URL del panel (Netlify), a donde vuelve el navegador después de conectar Google.
FRONTEND_URL=http://localhost:5173
AI_PROVIDER=anthropic
AI_API_KEY=
# Opcional: gpt-4o-mini (openai) o claude-3-5-sonnet-20241022 (anthropic)
AI_MODEL=
MEDIA_URL=/media/
MEDIA_ROOT=./media
